# Copy to .env and fill in. NEVER commit .env or any real private key.
# Testnet only — NEAR_NETWORK must stay "testnet".

# TaskBounty contract account on NEAR testnet (set after deploy)
CONTRACT_ID=
# Worker account (a testnet account you control; funded from the testnet faucet)
WORKER_ACCOUNT_ID=
# Private key for the worker account, "ed25519:..." format.
# Prefer WORKER_KEY_FILE (path to a key file) over pasting the key here.
WORKER_PRIVATE_KEY=
WORKER_KEY_FILE=
# Network / RPC
NEAR_NETWORK=testnet
RPC_URL=https://rpc.testnet.near.org
# Poll interval for --loop mode, in milliseconds
POLL_INTERVAL_MS=60000
# Per-fetch timeout, in milliseconds
FETCH_TIMEOUT_MS=10000
